{
  "name": "FixFlow development",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": {
      "label": "FixFlow Frontend",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    },
    "8000": {
      "label": "FixFlow API",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "postCreateCommand": "python -m pip install -r backend/requirements.txt && python -m pip install -r frontend/requirements-test.txt",
  "postStartCommand": "bash .devcontainer/start.sh"
}
